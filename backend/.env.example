# ============================================================
# .env.example  –  Copy this to .env and fill in your values
# ============================================================

# ---- Data Source -----------------------------------------------
# Options: YAHOO | ALPACA | OANDA | INTERACTIVE_BROKERS
DATA_SOURCE=YAHOO

# ---- Yahoo Finance (default, no key needed) --------------------
# Nothing required. Works out of the box.

# ---- Alpaca Markets (uncomment when you have a key) ------------
# ALPACA_API_KEY=your_api_key_here
# ALPACA_SECRET_KEY=your_secret_key_here
# ALPACA_BASE_URL=https://data.alpaca.markets

# ---- OANDA Forex (uncomment when you have a key) ---------------
# OANDA_API_KEY=your_api_key_here
# OANDA_ACCOUNT_ID=your_account_id_here
# OANDA_BASE_URL=https://api-fxtrade.oanda.com

# ---- Interactive Brokers TWS API (uncomment when ready) --------
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=1

# ---- Strategy Settings -----------------------------------------
SYMBOL=GC=F                # Yahoo Finance ticker for XAUUSD (Gold Futures)
FOREX_SYMBOL=XAUUSD=X     # Alternative Yahoo Finance forex ticker
USE_FUTURES=true           # true = GC=F  |  false = XAUUSD=X

# ---- Analysis Settings -----------------------------------------
ANALYSIS_INTERVAL_SECONDS=60   # How often the engine re-analyses
FLUSH_THRESHOLD_ATR=1.5        # Factor 1: flush must be > 1.5x ATR
MOMENTUM_CANDLE_ATR=1.2        # Factor 4: confirmation candle > 1.2x ATR

# ---- Risk Defaults (used in trade calculator) ------------------
DEFAULT_RISK_USD=500
TP1_R_MULTIPLE=2.0
TP2_R_MULTIPLE=3.0

# ---- ML / AI Backend -------------------------------------------
# Options: RULE_BASED | OLLAMA | OPENAI_COMPAT | DISABLED
ML_BACKEND=RULE_BASED

# ---- Ollama (local LLM) ----------------------------------------
# Download: https://ollama.com/download
# Run:      ollama serve
# Pull:     ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_USE_CHAT=false        # true = use /api/chat  |  false = /api/generate

# ---- OpenAI-Compatible (LM Studio, llama.cpp, vLLM, Groq) -----
# OPENAI_COMPAT_URL=http://localhost:1234/v1
# OPENAI_COMPAT_MODEL=local-model
# OPENAI_COMPAT_APIKEY=not-needed

# ---- LLM Inference Params --------------------------------------
LLM_TEMPERATURE=0.1          # Low = deterministic  |  High = creative
LLM_MAX_TOKENS=256           # Keep small — we only need a JSON blob

# ---- Server ----------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---- Active Timeframes (comma-separated, no spaces) ------------
# Engine runs analysis on ALL of these in parallel every tick
ACTIVE_TIMEFRAMES=5m,15m,1h
DEFAULT_TIMEFRAME=5m
